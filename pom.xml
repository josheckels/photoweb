<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>


    <repositories>
        <!-- Maven Central is included by default -->

        <!-- Add your new repository -->
        <repository>
            <id>Atlassian</id>
            <url>https://maven.artifacts.atlassian.com/</url>
        </repository>

        <!-- If you need to add credentials for the repository -->
        <!-- Define them in settings.xml, not in pom.xml for security -->
    </repositories>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
    </parent>

    <groupId>com.stampysoft</groupId>
    <artifactId>photoweb</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- Do not drop back to 4.10.0-1.5.11: its macosx-arm64 libopencv_videoio links against
             @loader_path/libOrbbecSDK.1.9.dylib, which upstream never packaged, so videoio fails to load and takes
             FaceDetectorYN's class initializer down with it. 4.11 onwards has no @loader_path dependencies. -->
        <opencv.version>4.13.0-1.5.13</opencv.version>
        <openblas.version>0.3.31-1.5.13</openblas.version>
        <javacpp.version>1.5.13</javacpp.version>
        <!-- The platform whose OpenCV natives get bundled. Change to linux-x86_64 to build for the server. -->
        <opencv.native.classifier>macosx-arm64</opencv.native.classifier>
    </properties>

    <dependencies>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>2.25.29</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-jasper</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.penggle</groupId>
            <artifactId>kaptcha</artifactId>
            <version>2.3.2</version>
        </dependency>
        <dependency>
            <groupId>com.drewnoakes</groupId>
            <artifactId>metadata-extractor</artifactId>
            <version>2.6.2</version>
        </dependency>
        <dependency>
            <groupId>com.sun.syndication</groupId>
            <artifactId>com.springsource.com.sun.syndication</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.jdom</groupId>
            <artifactId>jdom</artifactId>
            <version>1.1.3</version>
        </dependency>
        <!-- Spring Boot JPA Starter (includes Hibernate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.carrot2</groupId>
            <artifactId>morfologik-speller</artifactId>
            <version>2.1.9</version>
        </dependency>
        <!-- pgvector support for the face embedding column. Not managed by the Spring Boot BOM, so pin it to the
             parent's Hibernate version. Registers the vector JDBC type and the cosine_distance()/inner_product()
             HQL functions when the dialect is a PostgreSQLDialect. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-vector</artifactId>
            <version>${hibernate.version}</version>
        </dependency>
        <!-- OpenCV (YuNet detection + SFace embedding) for face tagging. The natives are pinned by explicit
             classifier rather than via opencv-platform: opencv-platform pulls ~1GB of natives for every platform,
             and the documented way to narrow it (javacpp.platform) only works as a -D command line property, not
             as a pom property. Face detection is admin-only (see FaceEncoder), so only the machine that runs the
             admin UI needs natives; add a second block with <classifier>linux-x86_64</classifier> if scanning ever
             has to run on the server. -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>opencv</artifactId>
            <version>${opencv.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>opencv</artifactId>
            <version>${opencv.version}</version>
            <classifier>${opencv.native.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>openblas</artifactId>
            <version>${openblas.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>openblas</artifactId>
            <version>${openblas.version}</version>
            <classifier>${opencv.native.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <version>${javacpp.version}</version>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <version>${javacpp.version}</version>
            <classifier>${opencv.native.classifier}</classifier>
        </dependency>
        <!-- Provides the compiled en_US.dict + en_US.info morfologik resources consumed by SpellCheckPane;
             transitive deps excluded as we only need the resource JAR. NOTE: LanguageTool removed the binary
             en_US.dict in 6.x (hunspell/ now holds only .txt files), so this must stay on the 5.x line. -->
        <dependency>
            <groupId>org.languagetool</groupId>
            <artifactId>language-en</artifactId>
            <version>5.9</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
